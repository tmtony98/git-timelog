HOME = Path.home()
DATA = Path(os.environ.get("GIT_TIMELOG_HOME") or HOME / ".local/share/git-timelog")
CONF_PATH = Path(os.environ.get("GIT_TIMELOG_CONFIG") or HOME / ".config/git-timelog/config.ini")
DB_PATH = DATA / "timelog.db"
LOG_PATH = DATA / "events.log"
HOOK_MARK = "# git-timelog"
HOOK_NAMES = ("post-checkout", "post-commit", "post-merge")
STATUSES = ("todo", "doing", "hold", "done")

DEFAULTS = {
    "repos": "",
    "author": "",  # empty = each repo's git config user.email
    "base_branches": "main,master,develop,dev,dev_*,development,staging,prod,production,release/*,HEAD",
    "session_gap_min": "120",
    "lead_in_min": "30",
    "stale_days": "7",
    "idle_hold_days": "3",      # unmerged branch untouched this long -> hold
    "agent_gap_min": "20",      # coding-agent session: your think/test time between turns counted up to this
    "session_done_hours": "12", # research-only agent session (no branch) idle this long -> done
    "agent_titles": "prompt",   # card title for agent sessions: "prompt" (first 80 chars) or "off"
    "idle_exit_min": "10",
    "port": "7777",
    "standup_dir": str(HOME / "Documents/git-timelog/standups"),
    "title": "git timelog",
}

# Merge-commit subjects that mean "branch X shipped".
MERGE_PATTERNS = [
    re.compile(r"Merged in (?P<b>\S+) \(pull request #\d+\)"),          # Bitbucket
    re.compile(r"Merge pull request #\d+ from [^/\s]+/(?P<b>\S+)"),      # GitHub
    re.compile(r"Merge branch '(?P<b>[^']+)'"),                          # GitLab / plain git
]


def load_conf():
    cp = configparser.ConfigParser()
    cp.optionxform = str  # keep project names' case
    cp["git-timelog"] = DEFAULTS
    cp.read(CONF_PATH)
    return cp


CP = load_conf()
C = CP["git-timelog"]


def save_conf():
    CONF_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(CONF_PATH, "w") as f:
        CP.write(f)


def repos():
    return [Path(p.strip()) for p in C["repos"].split(",") if p.strip()]


GENERAL = "General"


def projects():
    """[projects] config section: "Name = repo, repo". Unlisted repos are their own project."""
    if not CP.has_section("projects"):
        return {}
    return {name: [r.strip() for r in v.split(",") if r.strip()] for name, v in CP["projects"].items()}


def project_of(repo, table=None):
    for name, members in (projects() if table is None else table).items():
        if repo in members:
            return name
    return repo or GENERAL


def repo_name(repo):
    """Name of the main checkout, so every worktree of a repo shares one name."""
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    return Path(common).parent.name if common else Path(repo).name


def is_base(branch):
    if not branch or branch.startswith("refs/") or re.fullmatch(r"[0-9a-f]{7,40}", branch):
        return True  # stash/tag refs, detached HEAD
    return any(fnmatch(branch, p.strip()) for p in C["base_branches"].split(","))


def now():
    return int(dt.datetime.now().timestamp())


def git(repo, *args):
    return subprocess.run(["git", "-C", str(repo), *args], capture_output=True,
                          text=True, check=False).stdout


# ---------------------------------------------------------------- database

SCHEMA = """
CREATE TABLE IF NOT EXISTS tasks(
  id INTEGER PRIMARY KEY, repo TEXT, branch TEXT, title TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'doing', ticket TEXT, pr_url TEXT, note TEXT,
  created INTEGER, updated INTEGER, UNIQUE(repo, branch));
CREATE TABLE IF NOT EXISTS events(
  ts INTEGER, kind TEXT, repo TEXT, branch TEXT, sha TEXT, subject TEXT,
  UNIQUE(ts, kind, repo, branch, sha));
CREATE TABLE IF NOT EXISTS entries(
  id INTEGER PRIMARY KEY, task_id INTEGER, start INTEGER, end INTEGER,
  note TEXT, source TEXT);
CREATE TABLE IF NOT EXISTS meta(k TEXT PRIMARY KEY, v TEXT);
"""


def db():
    DATA.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    con.executescript(SCHEMA)
    if "reopened" not in [r[1] for r in con.execute("PRAGMA table_info(tasks)")]:
        # when you last moved the task off "done"; older merges must not undo that
        con.execute("ALTER TABLE tasks ADD COLUMN reopened INTEGER")
    if "held_auto" not in [r[1] for r in con.execute("PRAGMA table_info(tasks)")]:
        # 1 = put on hold by the idle rule, 0 = by you
        con.execute("ALTER TABLE tasks ADD COLUMN held_auto INTEGER")
        con.execute("UPDATE tasks SET status='doing' WHERE status='review'")  # review column retired in 0.3
    if "deleted" not in [r[1] for r in con.execute("PRAGMA table_info(tasks)")]:
        # deleted tasks stay in the table (so the branch isn't re-created) but are hidden everywhere
        con.execute("ALTER TABLE tasks ADD COLUMN deleted INTEGER NOT NULL DEFAULT 0")
    if "session" not in [r[1] for r in con.execute("PRAGMA table_info(tasks)")]:
        # coding-agent session id, for sessions that never left a base branch (research tasks)
        con.execute("ALTER TABLE tasks ADD COLUMN session TEXT")
    return con


def ensure_task(con, repo, branch, ts):
    if is_base(branch):
        return None
    row = con.execute("SELECT id FROM tasks WHERE repo=? AND branch=?", (repo, branch)).fetchone()
    if row:
        return row["id"]
    cur = con.execute(
        "INSERT INTO tasks(repo, branch, title, status, created, updated) VALUES(?,?,?,?,?,?)",
        (repo, branch, branch, "doing", ts, ts))
    return cur.lastrowid


_known = None


def known_repos():
    """Repo names we track: tracked repos plus every name listed under [projects]."""
    global _known
    if _known is None:
        _known = {repo_name(r) for r in repos()} | {m for ms in projects().values() for m in ms}
    return _known


def sync_hook_files():
    """Tell the agent hook what it may write down: tracked repo names, and whether to keep titles.

    The hook reads these plain files instead of the config, so sessions in other
    folders (and, with agent_titles = off, prompt text) never reach the event log.
    """
    global _known
    _known = None
    DATA.mkdir(parents=True, exist_ok=True)
    names = "".join(f"{n}\n" for n in sorted(known_repos()))
    path = DATA / "tracked-repos"
    if not path.exists() or path.read_text() != names:
        tmp = path.with_suffix(".tmp")
        tmp.write_text(names)
        tmp.replace(path)
    flag = DATA / "no-titles"
    if C["agent_titles"].strip().lower() == "off":
        flag.touch()
    elif flag.exists():
        flag.unlink()


def add_agent_event(con, ts, repo, branch, sid, subject, live):
    """A coding-agent session event (start, prompt, stop, end) from hooks/agent-hook.sh.

    The session itself is the task until it touches a feature branch: on a base
    branch (or outside a repo) a "session task" titled from the first prompt
    collects the time; once the session works on a branch, that branch's task
    takes over and the session's earlier research time is folded into it.
    """
    if repo not in known_repos():
        return  # sessions in folders we don't track
    con.execute("INSERT OR IGNORE INTO events VALUES(?,?,?,?,?,?)", (ts, "agent", repo, branch, sid, subject))
    what, _, title = subject.partition("|")
    if branch and not is_base(branch):
        ensure_task(con, repo, branch, ts)
        if live:
            con.execute("UPDATE tasks SET status='doing', updated=?, reopened=? WHERE repo=? AND branch=? "
                        "AND status IN ('done', 'hold') AND updated < ?", (ts, ts, repo, branch, ts))
        return
    row = con.execute("SELECT id, title FROM tasks WHERE session=?", (sid,)).fetchone()
    if row is None and what == "prompt":  # opening and closing the agent without asking anything isn't a task
        con.execute("INSERT INTO tasks(repo, branch, title, status, created, updated, session) VALUES(?,?,?,?,?,?,?)",
                    (repo, None, title or "Agent session", "doing", ts, ts, sid))
    elif row is not None and title and row["title"] == "Agent session":
        con.execute("UPDATE tasks SET title=? WHERE id=?", (title, row["id"]))
    if live and row is not None:
        if what == "end":
            con.execute("UPDATE tasks SET status='done', updated=? WHERE id=? AND status='doing'", (ts, row["id"]))
        elif what == "prompt":
            con.execute("UPDATE tasks SET status='doing', updated=?, reopened=? WHERE id=? "
                        "AND status IN ('done', 'hold')", (ts, ts, row["id"]))


def add_event(con, ts, kind, repo, branch, sha, subject, live=False):
    if kind == "agent":
        return add_agent_event(con, ts, repo, branch, sha, subject, live)
    con.execute("INSERT OR IGNORE INTO events VALUES(?,?,?,?,?,?)",
                (ts, kind, repo, branch, sha, subject))
    ensure_task(con, repo, branch, ts)
    if kind == "checkout" and subject.startswith("from:"):
        ensure_task(con, repo, subject[5:], ts)
    if live and kind in ("checkout", "commit"):
        # Back on a finished or held branch => working on it again. Only for events as
        # they happen: replayed history must not reopen tasks that shipped long ago.
        con.execute("UPDATE tasks SET status='doing', updated=?, reopened=? WHERE repo=? AND branch=? "
                    "AND status IN ('done', 'hold') AND updated < ?", (ts, ts, repo, branch, ts))
    if live and kind == "commit":
        # a new commit on a deleted task's branch means you're working on it again
        con.execute("UPDATE tasks SET deleted=0, status='doing' WHERE repo=? AND branch=? AND deleted=1",
                    (repo, branch))
    if kind in ("commit", "merge"):
        for pat in MERGE_PATTERNS:
            m = pat.match(subject)
            if m and ensure_task(con, repo, m.group("b"), ts):
                con.execute("UPDATE tasks SET status='done', updated=MAX(updated, ?) WHERE repo=? AND branch=? "
                            "AND COALESCE(reopened, 0) < ?", (ts, repo, m.group("b"), ts))
                break


def ingest(con):
    sync_hook_files()
    if not LOG_PATH.exists():
        return 0
    row = con.execute("SELECT v FROM meta WHERE k='offset'").fetchone()
    offset = int(row["v"]) if row else 0
    if LOG_PATH.stat().st_size < offset:
        offset = 0
    n = 0
    with open(LOG_PATH, "rb") as f:
        f.seek(offset)
        for raw in f:
            if not raw.endswith(b"\n"):
                break  # partial line still being written
            offset += len(raw)
            parts = raw.decode("utf-8", "replace").rstrip("\n").split("\t")
            if len(parts) < 6:
                continue
            ts, kind, repo, branch, sha, subject = parts[:6]
            add_event(con, int(ts), kind, repo, branch, sha, subject, live=True)
            n += 1
    con.execute("INSERT OR REPLACE INTO meta VALUES('offset', ?)", (str(offset),))
    row = con.execute("SELECT v FROM meta WHERE k='merged_check'").fetchone()
    if n or not row or now() - int(row["v"]) > 300:
        mark_merged(con)
    con.commit()
    return n


def mark_merged(con, only=None):
    """Mark tasks done whose branch is already contained in a base branch.

    Fast-forward and squash-free merges leave no "Merge ..." commit, so ask git
    which branches are inside main/develop/etc. A branch only counts if you
    committed on it (a fresh branch also sits inside main) and you haven't
    reopened it since its last commit.
    """
    seen = set()
    for repo in only or repos():
        name = repo_name(repo)
        if name in seen:
            continue
        seen.add(name)
        remotes = git(repo, "remote").split()
        bases = []
        for ref in git(repo, "for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes").split():
            head, _, rest = ref.partition("/")
            short = rest if head in remotes else ref  # origin/main -> main
            if short not in ("", "HEAD") and ref not in remotes and is_base(short):
                bases.append(ref)
        merged = set()
        for b in bases:
            merged.update(git(repo, "branch", "--merged", b, "--format=%(refname:short)").split())
        for branch in merged:
            tip = git(repo, "log", "-1", "--format=%ct", branch).strip()
            if is_base(branch) or not tip:
                continue
            con.execute("UPDATE tasks SET status='done' WHERE repo=? AND branch=? AND status!='done' "
                        "AND COALESCE(reopened, 0) < ? AND EXISTS (SELECT 1 FROM events e WHERE e.kind='commit' "
                        "AND e.repo=tasks.repo AND e.branch=tasks.branch)", (name, branch, int(tip)))
        # Squash and rebase merges put *copies* of the work on main, so the
        # ancestry check above misses them. Check the open tasks' branches by content.
        gone = set()
        for line in git(repo, "for-each-ref", "--format=%(refname:short) %(upstream:track)", "refs/heads").splitlines():
            ref, _, track = line.partition(" ")
            if track == "[gone]":
                gone.add(ref)  # remote branch deleted, usually right after its PR merged
        open_tasks = con.execute(
            "SELECT branch, COALESCE(reopened, 0) AS reopened FROM tasks WHERE repo=? AND branch IS NOT NULL "
            "AND status IN ('doing', 'hold') AND EXISTS (SELECT 1 FROM events e WHERE e.kind='commit' "
            "AND e.repo=tasks.repo AND e.branch=tasks.branch)", (name,)).fetchall()
        for t in open_tasks:
            branch = t["branch"]
            tip = git(repo, "log", "-1", "--format=%ct", branch, "--").strip()
            if not tip or int(tip) <= t["reopened"] or branch in merged:
                continue
            if branch in gone or any(landed_by_copy(repo, branch, b, tip) for b in bases):
                con.execute("UPDATE tasks SET status='done' WHERE repo=? AND branch=?", (name, branch))
    mark_idle(con)
    con.execute("INSERT OR REPLACE INTO meta VALUES('merged_check', ?)", (str(now()),))


def git_pipe(repo, data, *args):
    return subprocess.run(["git", "-C", str(repo), *args], input=data, capture_output=True,
                          text=True, check=False).stdout


def landed_by_copy(repo, branch, base, tip):
    """True if base already contains branch's changes via rebase or squash merge.

    Rebase: every branch commit has an equivalent patch on base (`git cherry`).
    Squash: the branch's total diff equals the diff of one commit on base made
    after the branch's last commit. Compares patch ids; writes nothing.
    """
    mb = git(repo, "merge-base", base, branch).strip()
    if not mb:
        return False
    cherry = git(repo, "cherry", base, branch).split("\n")
    marks = [ln[:1] for ln in cherry if ln]
    if marks and all(m == "-" for m in marks):
        return True
    want = git_pipe(repo, git(repo, "diff", mb, branch), "patch-id", "--stable").split()
    if not want:
        return False
    log = git(repo, "log", "-p", "--no-merges", f"--since={tip}", f"{mb}..{base}")
    have = {ln.split()[0] for ln in git_pipe(repo, log, "patch-id", "--stable").splitlines() if ln.strip()}
    return want[0] in have


# Last time you were on a task's branch: committed on it, switched to it or away from it.
LAST_SEEN = ("SELECT MAX(e.ts) FROM events e WHERE e.repo=tasks.repo AND e.kind NOT IN ('merge', 'merged') "
             "AND (e.branch=tasks.branch OR e.subject='from:' || tasks.branch "
             "OR (e.kind='agent' AND e.sha=tasks.session))")


def mark_idle(con):
    """Doing tasks whose (unmerged) branch you haven't been on for idle_hold_days go on hold.

    Runs after mark_merged, so merged branches are already done. Waits the same
    number of days after you move a task back to doing yourself.
    """
    cutoff = now() - int(float(C["idle_hold_days"]) * 86400)
    con.execute(f"UPDATE tasks SET status='hold', held_auto=1 WHERE status='doing' AND branch IS NOT NULL "
                f"AND COALESCE(reopened, 0) < ? AND COALESCE(({LAST_SEEN}), 0) < ?", (cutoff, cutoff))
    # Research-only agent sessions have nothing to merge: done once they go quiet.
    cutoff = now() - int(float(C["session_done_hours"]) * 3600)
    con.execute(f"UPDATE tasks SET status='done' WHERE status='doing' AND session IS NOT NULL AND branch IS NULL "
                f"AND COALESCE(reopened, 0) < ? AND COALESCE(({LAST_SEEN}), 0) < ?", (cutoff, cutoff))


def backfill(con, days, only=None):
    n = 0
    since = now() - days * 86400
    for repo in only or repos():
        name = repo_name(repo)
        author = C["author"] or git(repo, "config", "user.email").strip()
        out = git(repo, "log", "--all", "--source", "-i", f"--author={author}",
                  f"--since={days}.days", "--format=%at%x09%S%x09%h%x09%s")
        for line in out.splitlines():
            ts, ref, sha, subject = (line.split("\t", 3) + [""] * 4)[:4]
            branch = re.sub(r"^refs/(heads|remotes/[^/]+)/", "", ref)
            add_event(con, int(ts), "commit", name, branch, sha, subject)
            n += 1
        out = git(repo, "reflog", "--date=unix", "--format=%gd%x09%gs")
        for line in out.splitlines():
            m = re.match(r"HEAD@\{(\d+)\}\tcheckout: moving from (\S+) to (\S+)", line)
            if m and int(m.group(1)) >= since:
                add_event(con, int(m.group(1)), "checkout", name, m.group(3), "", "from:" + m.group(2))
                n += 1
    mark_stale(con)
    mark_merged(con, only)
    con.commit()
    return n


def mark_stale(con):
    """Branches with no activity for stale_days are assumed shipped."""
    cutoff = now() - int(C["stale_days"]) * 86400
    con.execute("UPDATE tasks SET status='done' WHERE branch IS NOT NULL AND status='doing' AND id NOT IN "
                "(SELECT t.id FROM tasks t JOIN events e ON e.repo=t.repo AND e.branch=t.branch WHERE e.ts>=?)",
                (cutoff,))


# ---------------------------------------------------------------- time model

def intervals(con):
    """Return [(task_id, start, end, source)] from git events + manual entries.

    Walk events in time order. The gap since the previous event belongs to the
    branch that was checked out during it, if shorter than the session gap;
    otherwise a new session starts and its first commit gets a lead-in credit.
    """
    gap, lead = int(C["session_gap_min"]) * 60, int(C["lead_in_min"]) * 60
    tasks = {(r["repo"], r["branch"]): r["id"] for r in con.execute("SELECT id, repo, branch FROM tasks")}
    out, last_ts = [], None
    for e in con.execute("SELECT * FROM events WHERE kind != 'agent' ORDER BY ts"):  # agent turns: agent_intervals
        repo, ts = e["repo"], e["ts"]
        # Commits know their branch (worktrees can have several checked out at once).
        before = e["subject"][5:] if e["kind"] == "checkout" else e["branch"]
        tid = tasks.get((repo, before))
        if last_ts is not None and ts - last_ts < gap:
            if tid:
                out.append((tid, last_ts, ts, "git"))
        elif tid and e["kind"] != "checkout":
            out.append((tid, ts - lead, ts, "git"))
        last_ts = ts
    out = union(out + agent_intervals(con, tasks, gap))  # git gaps and agent turns often overlap
    for r in con.execute("SELECT task_id, start, COALESCE(end, ?) AS end, source FROM entries", (now(),)):
        out.append((r["task_id"], r["start"], r["end"], r["source"]))
    return out


def agent_sessions(con):
    """{session id: [event rows in time order]} for coding-agent sessions."""
    out = {}
    for e in con.execute("SELECT ts, repo, branch, sha, subject FROM events WHERE kind='agent' ORDER BY ts"):
        out.setdefault(e["sha"], []).append(e)
    return out


def folded_sessions(con):
    """Sessions that worked on a feature branch: their research time belongs to that branch's task."""
    return {sid for sid, evs in agent_sessions(con).items()
            if any(e["branch"] and not is_base(e["branch"]) for e in evs)}


def agent_intervals(con, tasks, gap):
    """Time from coding-agent turns.

    While the agent is working (prompt -> stop) the gap counts up to the git
    session gap; your think/test time between turns (stop -> next prompt)
    counts up to agent_gap_min. Base-branch events go to the session's
    nearest feature branch if it has one, otherwise to its session task.
    """
    think = int(C["agent_gap_min"]) * 60
    session_task = {r["session"]: r["id"]
                    for r in con.execute("SELECT id, session FROM tasks WHERE session IS NOT NULL")}
    out = []
    for sid, evs in agent_sessions(con).items():
        own = [tasks.get((e["repo"], e["branch"])) if e["branch"] and not is_base(e["branch"]) else None
               for e in evs]
        target = []
        for i, t in enumerate(own):
            if t is None:
                later = next((x for x in own[i + 1:] if x), None)
                earlier = next((x for x in reversed(own[:i]) if x), None)
                t = later or earlier or session_task.get(sid)
            target.append(t)
        for i in range(1, len(evs)):
            a, b = evs[i - 1], evs[i]
            limit = gap if a["subject"].startswith("prompt") else think
            if target[i] and 0 <= b["ts"] - a["ts"] < limit:
                out.append((target[i], a["ts"], b["ts"], "agent"))
    return out


def union(ivs):
    """Merge overlapping intervals of the same task so no minute is counted twice."""
    by = {}
    for tid, s, e, src in ivs:
        by.setdefault(tid, []).append((s, e, src))
    out = []
    for tid, lst in by.items():
        lst.sort()
        cs, ce, csrc = lst[0]
        for s, e, src in lst[1:]:
            if s <= ce:
                ce = max(ce, e)
            else:
                out.append((tid, cs, ce, csrc))
                cs, ce, csrc = s, e, src
        out.append((tid, cs, ce, csrc))
    return out


def summary(con):
    ingest(con)
    today = dt.date.today()
    week_start = today - dt.timedelta(days=today.weekday())
    per_task, per_day = {}, {}
    folded = folded_sessions(con)
    hidden = {r["id"] for r in con.execute("SELECT id, session, branch, deleted FROM tasks")
              if r["deleted"] or (r["session"] in folded and r["branch"] is None)}
    for tid, s, e, _ in intervals(con):
        if tid in hidden:
            continue
        sec = max(0, e - s)
        per_task[tid] = per_task.get(tid, 0) + sec
        d = dt.date.fromtimestamp(s)
        per_day.setdefault(d, {}).setdefault(tid, 0)
        per_day[d][tid] += sec
    commits = {r["id"]: dict(r) for r in con.execute(
        "SELECT t.id, COUNT(*) n, MAX(e.ts) last FROM events e "
        "JOIN tasks t ON t.repo=e.repo AND t.branch=e.branch WHERE e.kind='commit' GROUP BY t.id")}
    last_subject = {r["id"]: r["subject"] for r in con.execute(
        "SELECT t.id, e.subject FROM events e JOIN tasks t ON t.repo=e.repo AND t.branch=e.branch "
        "WHERE e.kind='commit' ORDER BY e.ts")}
    tasks = []
    for t in con.execute(f"SELECT *, ({LAST_SEEN}) AS last_seen FROM tasks WHERE deleted=0 ORDER BY updated DESC"):
        if t["id"] in hidden:
            continue  # session folded into its branch's task
        c = commits.get(t["id"], {})
        tasks.append({**dict(t), "hours": round(per_task.get(t["id"], 0) / 3600, 2),
                      "commits": c.get("n", 0), "last": max(c.get("last") or 0, t["updated"] or 0),
                      "last_subject": last_subject.get(t["id"], "")})
    days = [{"date": (today - dt.timedelta(days=13 - i)).isoformat(),
             "tasks": {str(k): round(v / 3600, 2)
                       for k, v in per_day.get(today - dt.timedelta(days=13 - i), {}).items()}}
            for i in range(14)]

    table = projects()
    for t in tasks:
        t["project"] = project_of(t["repo"], table)
    proj_of_task = {t["id"]: t["project"] for t in tasks}
    wk_commits = {}
    for r in con.execute("SELECT repo, COUNT(*) n FROM events WHERE kind='commit' AND ts>=? GROUP BY repo",
                         (int(dt.datetime.combine(week_start, dt.time()).timestamp()),)):
        p = project_of(r["repo"], table)
        wk_commits[p] = wk_commits.get(p, 0) + r["n"]

    def kpi(project=None):
        def mine(tid):
            return project is None or proj_of_task.get(tid) == project

        def hrs(pred):
            return round(sum(sec for d, v in per_day.items() if pred(d)
                             for tid, sec in v.items() if mine(tid)) / 3600, 1)
        return {"today": hrs(lambda d: d == today), "week": hrs(lambda d: d >= week_start),
                "active": sum(1 for t in tasks if mine(t["id"]) and t["status"] == "doing"),
                "commits_week": sum(n for p, n in wk_commits.items() if project is None or p == project)}

    tracked = {repo_name(r) for r in repos()}
    names = list(table) + sorted(({t["project"] for t in tasks} | {project_of(r, table) for r in tracked})
                                 - set(table) - {GENERAL})
    if any(t["project"] == GENERAL for t in tasks):
        names.append(GENERAL)
    members = {n: table.get(n) or sorted({r for r in tracked if project_of(r, table) == n}
                                         | {t["repo"] for t in tasks if t["project"] == n and t["repo"]})
               for n in names}
    timer = con.execute("SELECT e.*, t.title FROM entries e JOIN tasks t ON t.id=e.task_id "
                        "WHERE e.end IS NULL").fetchone()
    return {
        "title": C["title"], "version": __version__,
        "kpi": kpi(),
        "projects": [{"name": n, "repos": members[n], "kpi": kpi(n)} for n in names],
        "repos": sorted(tracked | {t["repo"] for t in tasks if t["repo"]}),
        "tasks": tasks, "days": days,
        "activity": [{**dict(r), "project": project_of(r["repo"], table)}
                     for r in con.execute("SELECT * FROM events WHERE kind != 'agent' ORDER BY ts DESC LIMIT 300")],
        "timer": dict(timer) if timer else None,
    }


# ---------------------------------------------------------------- mutations

def find_task(con, ref):
    if str(ref).isdigit():
        row = con.execute("SELECT * FROM tasks WHERE id=?", (int(ref),)).fetchone()
    else:
        row = con.execute("SELECT * FROM tasks WHERE title=? OR branch=? ORDER BY updated DESC",
                          (ref, ref)).fetchone()
    if not row:
        raise SystemExit(f"git-timelog: no task '{ref}'")
    return row


def current_task(con):
    """Task for the branch checked out in the current directory, if any."""
    top = git(".", "rev-parse", "--show-toplevel").strip()
    branch = git(".", "rev-parse", "--abbrev-ref", "HEAD").strip()
    if not top or is_base(branch):
        return None
    tid = ensure_task(con, Path(top).name, branch, now())
    con.commit()
    return con.execute("SELECT * FROM tasks WHERE id=?", (tid,)).fetchone()


def create_task(con, title, repo=None, status="todo"):
    cur = con.execute("INSERT INTO tasks(repo, branch, title, status, created, updated) VALUES(?,?,?,?,?,?)",
                      (repo, None, title, status, now(), now()))
    con.commit()
    return cur.lastrowid


def update_task(con, tid, fields):
    allowed = {k: v for k, v in fields.items() if k in ("title", "status", "ticket", "pr_url", "note")}
    if "status" in allowed and allowed["status"] not in STATUSES:
        raise ValueError(f"status must be one of {', '.join(STATUSES)}")
    if allowed.get("status") not in (None, "done"):
        allowed["reopened"] = now()  # your choice wins over older merges and the idle rule
    if "status" in allowed:
        allowed["held_auto"] = 0
    if allowed:
        sets = ", ".join(f"{k}=?" for k in allowed)
        con.execute(f"UPDATE tasks SET {sets}, updated=? WHERE id=?", (*allowed.values(), now(), tid))
        con.commit()


def timer_start(con, tid):
    timer_stop(con)
    con.execute("INSERT INTO entries(task_id, start, end, note, source) VALUES(?,?,NULL,'','timer')",
                (tid, now()))
    con.execute("UPDATE tasks SET status='doing', updated=? WHERE id=? AND status='todo'", (now(), tid))
    con.commit()


def delete_task(con, tid, deleted=True):
    """Hide a task and its time from the board, totals and reports (restorable)."""
    con.execute("UPDATE entries SET end=? WHERE end IS NULL AND task_id=?", (now(), tid))
    con.execute("UPDATE tasks SET deleted=?, updated=? WHERE id=?", (1 if deleted else 0, now(), tid))
    con.commit()


def timer_stop(con):
    con.execute("UPDATE entries SET end=? WHERE end IS NULL", (now(),))
    con.commit()


def log_time(con, tid, minutes, note=""):
    end = now()
    con.execute("INSERT INTO entries(task_id, start, end, note, source) VALUES(?,?,?,?,'manual')",
                (tid, end - minutes * 60, end, note))
    con.commit()


def parse_duration(s):
    m = re.fullmatch(r"(?:(\d+(?:\.\d+)?)h)?\s*(?:(\d+)m)?", s.strip())
    if not m or not any(m.groups()):
        raise SystemExit(f"git-timelog: bad duration '{s}' (use 45m, 1h, 1h30m)")
    return int(float(m.group(1) or 0) * 60 + int(m.group(2) or 0))


# ---------------------------------------------------------------- report

def report(con, day=None):
    s = summary(con)
    day = day or dt.date.today()
    names = {t["id"]: t for t in s["tasks"]}
    start = int(dt.datetime.combine(day, dt.time()).timestamp())
    end = start + 86400
    per = {}
    for tid, a, b, _ in intervals(con):
        if start <= a < end and tid in names:  # skips deleted tasks
            per[tid] = per.get(tid, 0) + (b - a)
    gone = {(r["repo"], r["branch"]) for r in con.execute("SELECT repo, branch FROM tasks WHERE deleted=1")}
    lines = ["---", f"date: {day.isoformat()}", "tags: [standup, git-timelog]",
             f"hours: {round(sum(per.values()) / 3600, 1)}", "---", f"# Standup {day.isoformat()}", "",
             "## Done / worked on"]
    by_branch = {}
    for e in con.execute("SELECT * FROM events WHERE kind='commit' AND ts>=? AND ts<? ORDER BY ts", (start, end)):
        if (e["repo"], e["branch"]) in gone:
            continue
        by_branch.setdefault((e["repo"], e["branch"]), []).append(e["subject"])
    if not by_branch:
        lines.append("- (no commits)")
    for (repo, br), subs in by_branch.items():
        lines.append(f"- **{br}** ({repo})")
        lines += [f"  - {x}" for x in subs]
    lines += ["", "## Time", "| Task | Status | Hours |", "|---|---|---|"]
    for tid, sec in sorted(per.items(), key=lambda x: -x[1]):
        if tid in names:
            lines.append(f"| {names[tid]['title']} | {names[tid]['status']} | {sec / 3600:.1f} |")
    lines += ["", "## In progress"]
    lines += [f"- {t['title']}" for t in s["tasks"] if t["status"] == "doing"] or ["- none"]
    lines += ["", "## On hold"]
    lines += [f"- {t['title']}" for t in s["tasks"] if t["status"] == "hold"] or ["- none"]
    lines += ["", "## Blockers", "- ", ""]
    out = Path(os.path.expanduser(C["standup_dir"]))
    out.mkdir(parents=True, exist_ok=True)
    path = out / f"{day.isoformat()}.md"
    path.write_text("\n".join(lines))
    return path


# ---------------------------------------------------------------- server

def web_dir():
    for d in (Path(__file__).resolve().parent / "web", DATA / "web"):
        if (d / "index.html").exists():
            return d
    raise SystemExit("git-timelog: web/index.html not found; re-run install.sh")


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def send(self, code, body, ctype="application/json"):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def body(self):
        n = int(self.headers.get("Content-Length") or 0)
        return json.loads(self.rfile.read(n) or b"{}")

    def route(self, method):
        # Only same-origin browser requests may mutate (blocks drive-by POSTs from other sites).
        origin = self.headers.get("Origin")
        if method != "GET" and origin and origin != f"http://{self.headers.get('Host')}":
            return self.send(403, {"error": "cross-origin request refused"})
        con = db()
        try:
            p = self.path.split("?")[0]
            if method == "GET" and p in ("/", "/index.html"):
                return self.send(200, (web_dir() / "index.html").read_bytes(), "text/html; charset=utf-8")
            if method == "GET" and p == "/api/summary":
                return self.send(200, summary(con))
            if method == "POST" and p == "/api/task":
                b = self.body()
                return self.send(201, {"id": create_task(con, b["title"].strip(), b.get("repo"))})
            m = re.fullmatch(r"/api/task/(\d+)", p)
            if method == "PATCH" and m:
                b = self.body()
                if "deleted" in b:
                    delete_task(con, int(m.group(1)), bool(b["deleted"]))
                update_task(con, int(m.group(1)), b)
                return self.send(200, {"ok": True})
            if method == "DELETE" and m:
                delete_task(con, int(m.group(1)))
                return self.send(200, {"ok": True})
            if method == "POST" and p == "/api/timer":
                b = self.body()
                timer_start(con, int(b["task_id"])) if b.get("action") == "start" else timer_stop(con)
                return self.send(200, {"ok": True})
            if method == "POST" and p == "/api/log":
                b = self.body()
                log_time(con, int(b["task_id"]), int(b["minutes"]), b.get("note", ""))
                return self.send(200, {"ok": True})
            if method == "POST" and p == "/api/report":
                return self.send(200, {"path": str(report(con))})
            self.send(404, {"error": "not found"})
        except (KeyError, ValueError, TypeError) as e:
            self.send(400, {"error": str(e)})
        finally:
            con.close()

    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def do_PATCH(self):
        self.route("PATCH")

    def do_DELETE(self):
        self.route("DELETE")


def serve(port=None):
    idle = int(C["idle_exit_min"]) * 60
    if os.environ.get("LISTEN_FDS") == "1":  # systemd socket activation: fd 3
        srv = HTTPServer(("127.0.0.1", 0), Handler, bind_and_activate=False)
        srv.socket = socket.socket(fileno=3)
    else:
        srv = HTTPServer(("127.0.0.1", port or int(C["port"])), Handler)
        print(f"git timelog dashboard: http://localhost:{srv.server_port}  (Ctrl-C to stop)")
        idle = 0
    srv.timeout = idle or None
    state = {"idle": False}
    srv.handle_timeout = lambda: state.update(idle=True)
    try:
        while not state["idle"]:
            srv.handle_request()
    except KeyboardInterrupt:
        pass


# ---------------------------------------------------------------- setup

def hook_script():
    for p in (Path(__file__).resolve().parent / "hooks/hook.sh", DATA / "hooks/hook.sh"):
        if p.exists():
            return p
    raise SystemExit("git-timelog: hooks/hook.sh not found; re-run install.sh")


AGENTS = {
    # agent: (config file, {our event: the agent's event name}, extra fields per hook)
    "claude": ("~/.claude/settings.json",
               {"start": "SessionStart", "prompt": "UserPromptSubmit", "stop": "Stop", "end": "SessionEnd"},
               {"timeout": 5}),
    "codex": ("~/.codex/hooks.json",
              {"start": "SessionStart", "prompt": "UserPromptSubmit", "stop": "Stop", "end": "SessionEnd"},
              {"timeout": 5}),
    "gemini": ("~/.gemini/settings.json",
               {"start": "SessionStart", "prompt": "BeforeAgent", "stop": "AfterAgent", "end": "SessionEnd"},
               {"name": "git-timelog", "timeout": 5000}),
    "cursor": ("~/.cursor/hooks.json",
               {"start": "sessionStart", "prompt": "beforeSubmitPrompt", "stop": "stop", "end": "sessionEnd"},
               {}),
}


def is_ours(h):
    """A hook entry running our agent hook, wherever git-timelog is installed or checked out."""
    cmd = str(h.get("command", "")) if isinstance(h, dict) else ""
    return cmd.endswith("/hooks/agent-hook.sh") and "git-timelog" in cmd


def agent_config(agent, hook):
    """The hook entries git-timelog needs in an agent's config file."""
    _, events, extra = AGENTS[agent]
    if agent == "cursor":
        return {"version": 1, "hooks": {ev: [{"command": hook}] for ev in events.values()}}
    return {"hooks": {ev: [{"hooks": [{"type": "command", "command": hook, **extra}]}] for ev in events.values()}}


def merge_hooks(cfg, agent, hook):
    """Add (or re-point) our hooks in cfg in place. Returns True if anything changed."""
    _, events, extra = AGENTS[agent]
    hooks = cfg.setdefault("hooks", {})
    changed = False
    if agent == "cursor" and "version" not in cfg:
        cfg["version"] = 1
        changed = True
    for ev in events.values():
        entries = hooks.setdefault(ev, [])
        if not isinstance(entries, list):
            raise SystemExit(f"git-timelog: \"hooks.{ev}\" isn't a list in the agent's config; nothing changed.")
        mine = [h for e in entries
                for h in ([e] if agent == "cursor" else (e.get("hooks", []) if isinstance(e, dict) else []))
                if is_ours(h)]
        if mine:
            for h in mine:
                if h["command"] != hook:  # installed somewhere else before: point at this copy
                    h["command"] = hook
                    changed = True
            continue
        entries.append({"command": hook} if agent == "cursor"
                       else {"hooks": [{"type": "command", "command": hook, **extra}]})
        changed = True
    return changed


def strip_hooks(cfg, agent):
    """Remove our hooks from cfg in place, dropping containers they leave empty. Returns True if changed."""
    hooks = cfg.get("hooks")
    if not isinstance(hooks, dict):
        return False
    changed = False
    for ev in list(hooks):
        if not isinstance(hooks[ev], list):
            continue
        kept = []
        for e in hooks[ev]:
            if agent == "cursor":
                if is_ours(e):
                    changed = True
                    continue
            elif isinstance(e, dict) and isinstance(e.get("hooks"), list):
                inner = [h for h in e["hooks"] if not is_ours(h)]
                if len(inner) != len(e["hooks"]):
                    changed = True
                    if not inner:
                        continue
                    e = {**e, "hooks": inner}
            kept.append(e)
        if kept:
            hooks[ev] = kept
        else:
            del hooks[ev]
    if not hooks:
        del cfg["hooks"]
    return changed


def agent_setup(agent, mode="print"):
    """Print, write or remove the hook config that makes a coding agent report its sessions.

    --write and --remove edit only the "hooks" part of the agent's config file,
    keep a backup next to it first, and do nothing if there's nothing to change.
    """
    path = Path(os.path.expanduser(AGENTS[agent][0]))
    hook = None
    for p in (DATA / "hooks/agent-hook.sh", Path(__file__).resolve().parent / "hooks/agent-hook.sh"):
        if p.exists():
            hook = str(p)
            break
    if not hook:
        raise SystemExit("git-timelog: hooks/agent-hook.sh not found; re-run install.sh")
    if mode != "remove" and not shutil.which("jq"):
        print("WARNING: jq is not installed, so the hook can't read the agent's events.\n"
              "Install it first (e.g. sudo apt install jq, brew install jq).", file=sys.stderr)
    sync_hook_files()
    if mode == "print":
        print(f"# Add to {AGENTS[agent][0]} (merge into the existing \"hooks\" if the file has one),")
        print(f"# or let git timelog do it: git timelog agent-setup {agent} --write")
        print(json.dumps(agent_config(agent, hook), indent=2))
    else:
        if not path.parent.is_dir():
            raise SystemExit(f"git-timelog: {path.parent} doesn't exist. Is {agent} installed? Nothing changed.")
        try:
            cfg = json.loads(path.read_text()) if path.exists() and path.read_text().strip() else {}
        except ValueError as e:
            raise SystemExit(f"git-timelog: {path} isn't valid JSON ({e}). Fix it first; nothing changed.")
        if not isinstance(cfg, dict) or not isinstance(cfg.get("hooks", {}), dict):
            raise SystemExit(f"git-timelog: unexpected layout in {path}; nothing changed. "
                             f"Use 'git timelog agent-setup {agent}' and add the hooks by hand.")
        changed = merge_hooks(cfg, agent, hook) if mode == "write" else strip_hooks(cfg, agent)
        if not changed:
            print(f"{path}: {'already set up' if mode == 'write' else 'no git-timelog hooks found'}; nothing changed.")
        else:
            if path.exists():
                backup = path.with_name(path.name + ".git-timelog.bak")
                shutil.copy2(path, backup)
                print(f"backup: {backup}")
            tmp = path.with_name(path.name + ".git-timelog.tmp")
            tmp.write_text(json.dumps(cfg, indent=2) + "\n")
            tmp.replace(path)
            print(f"{path}: git-timelog hooks {'added' if mode == 'write' else 'removed'}.")
    if mode != "remove":
        if agent == "codex":
            print("Next: run /hooks inside Codex once to review and trust the hooks.")
        if agent == "gemini":
            print("Note: depending on your Gemini CLI version, hooks may need enabling in its settings.")
        if mode == "write":
            print("New sessions are tracked from their first prompt; restart open sessions to pick it up.")


def init_repo(path, days):
    top = git(path, "rev-parse", "--show-toplevel").strip()
    if not top:
        raise SystemExit(f"git-timelog: {path} is not a git repository")
    repo = Path(top)
    hooks_dir = Path(git(repo, "rev-parse", "--git-path", "hooks").strip())
    if not hooks_dir.is_absolute():
        hooks_dir = repo / hooks_dir
    git_dir = Path(git(repo, "rev-parse", "--absolute-git-dir").strip())
    if git_dir not in hooks_dir.resolve().parents:
        # core.hooksPath points into the work tree (Husky etc.): those files are
        # committed or regenerated, so don't edit them behind the user's back.
        hook = hook_script()
        print(f"hooks live in {hooks_dir} (core.hooksPath); add this line to post-checkout,\n"
              f"post-commit and post-merge there yourself, replacing NAME with the hook name:\n"
              f'  [ -x "{hook}" ] && "{hook}" NAME "$@"; true  {HOOK_MARK}')
    else:
        install_hooks(hooks_dir)
    listed = [str(p) for p in repos()]
    if str(repo) not in listed:
        C["repos"] = ",".join(listed + [str(repo)])
        save_conf()
    sync_hook_files()
    con = db()
    n = backfill(con, days, only=[repo]) if days else 0
    print(f"tracking {repo}; backfilled {n} events")


def install_hooks(hooks_dir):
    hooks_dir.mkdir(parents=True, exist_ok=True)
    hook = hook_script()
    for name in HOOK_NAMES:
        f = hooks_dir / name
        line = f'[ -x "{hook}" ] && "{hook}" {name} "$@"; true  {HOOK_MARK}\n'
        if f.exists():
            text = f.read_text()
            if HOOK_MARK in text:
                continue
            f.write_text(text.rstrip("\n") + "\n" + line)  # chain after the existing hook
        else:
            f.write_text("#!/bin/sh\n" + line)
        f.chmod(0o755)


def remove_repo(path):
    top = git(path, "rev-parse", "--show-toplevel").strip() or str(Path(path).resolve())
    hooks_dir = Path(git(top, "rev-parse", "--git-path", "hooks").strip() or ".git/hooks")
    if not hooks_dir.is_absolute():
        hooks_dir = Path(top) / hooks_dir
    for name in HOOK_NAMES:
        f = hooks_dir / name
        if f.exists() and HOOK_MARK in f.read_text():
            kept = [ln for ln in f.read_text().splitlines(True) if HOOK_MARK not in ln]
            if "".join(kept).strip() in ("", "#!/bin/sh"):
                f.unlink()
            else:
                f.write_text("".join(kept))
    C["repos"] = ",".join(str(p) for p in repos() if str(p) != top)
    save_conf()
    sync_hook_files()
    print(f"stopped tracking {top}")


