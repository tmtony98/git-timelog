# ---------------------------------------------------------------- cli

def main():
    ap = argparse.ArgumentParser(prog="git timelog", description="Your git history is already a timesheet.")
    ap.add_argument("--version", action="version", version=__version__)
    sub = ap.add_subparsers(dest="cmd", metavar="command")
    p = sub.add_parser("init", help="track this repo: install hooks + backfill history")
    p.add_argument("path", nargs="?", default=".")
    p.add_argument("--days", type=int, default=30, help="days of history to import (default 30, 0 = none)")
    p = sub.add_parser("remove", help="stop tracking a repo and remove its hooks")
    p.add_argument("path", nargs="?", default=".")
    sub.add_parser("repos", help="list tracked repos")
    p = sub.add_parser("ls", help="list tasks with hours")
    p.add_argument("--all", action="store_true", help="include done tasks")
    p = sub.add_parser("add", help="add a task that is not a branch (meeting, review…)")
    p.add_argument("title"); p.add_argument("--repo")
    p = sub.add_parser("status", help="set task status")
    p.add_argument("task"); p.add_argument("status", choices=STATUSES)
    p = sub.add_parser("set", help="set task field")
    p.add_argument("task"); p.add_argument("field", choices=("title", "ticket", "pr_url", "note")); p.add_argument("value")
    p = sub.add_parser("start", help="start a timer (default: current branch)")
    p.add_argument("task", nargs="?")
    sub.add_parser("stop", help="stop the running timer")
    p = sub.add_parser("delete", help="hide a task and its time (undo with restore)")
    p.add_argument("task")
    p = sub.add_parser("restore", help="bring a deleted task back")
    p.add_argument("task")
    p = sub.add_parser("log", help="log time manually: git timelog log [task] 1h30m 'note'")
    p.add_argument("args", nargs="+")
    p = sub.add_parser("report", help="write the standup note for a day")
    p.add_argument("date", nargs="?", help="YYYY-MM-DD (default today)")
    p = sub.add_parser("serve", help="run the dashboard in the foreground")
    p.add_argument("--port", type=int)
    sub.add_parser("open", help="open the dashboard in a browser")
    p = sub.add_parser("ingest", help="import queued hook events (automatic on every read)")
    p.add_argument("--backfill", type=int, metavar="DAYS")
    sub.add_parser("demo", help="fill an empty database with fictional data")
    p = sub.add_parser("agent-setup", help="set up session tracking for a coding agent (prints the config; "
                                           "--write adds it for you, --remove takes it out)")
    p.add_argument("agent", choices=sorted(AGENTS))
    g = p.add_mutually_exclusive_group()
    g.add_argument("--write", action="store_true", help="add the hooks to the agent's config (keeps a backup)")
    g.add_argument("--remove", action="store_true", help="remove git-timelog's hooks from the agent's config")
    a = ap.parse_args()

    if a.cmd is None:
        ap.print_help()
        return
    if a.cmd == "init":
        return init_repo(a.path, a.days)
    if a.cmd == "remove":
        return remove_repo(a.path)
    if a.cmd == "repos":
        print("\n".join(str(r) for r in repos()) or "no repos tracked; run `git timelog init` inside one")
        return
    if a.cmd == "serve":
        return serve(a.port)
    if a.cmd == "open":
        url = f"http://localhost:{C['port']}"
        opener = "open" if sys.platform == "darwin" else "xdg-open"
        subprocess.Popen([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(url)
        return
    if a.cmd == "demo":
        return demo()
    if a.cmd == "agent-setup":
        return agent_setup(a.agent, "write" if a.write else "remove" if a.remove else "print")
    con = db()
    if a.cmd == "ingest":
        if a.backfill:
            print(f"backfilled {backfill(con, a.backfill)} events")
        print(f"ingested {ingest(con)} events")
    elif a.cmd == "ls":
        for t in summary(con)["tasks"]:
            if a.all or t["status"] != "done":
                print(f"#{t['id']:<4} {t['status']:<7} {t['hours']:>6.1f}h  {t['title']}"
                      + (f"  [{t['repo']}]" if t["repo"] else ""))
    elif a.cmd == "add":
        print(f"task #{create_task(con, a.title, a.repo)}")
    elif a.cmd in ("status", "set"):
        t = find_task(con, a.task)
        field, value = ("status", a.status) if a.cmd == "status" else (a.field, a.value)
        update_task(con, t["id"], {field: value})
        print(f"#{t['id']} {field} = {value}")
    elif a.cmd == "start":
        t = find_task(con, a.task) if a.task else current_task(con)
        if not t:
            raise SystemExit("git-timelog: not on a feature branch; name a task")
        timer_start(con, t["id"])
        print(f"timer started: {t['title']}")
    elif a.cmd == "stop":
        timer_stop(con)
        print("timer stopped")
    elif a.cmd in ("delete", "restore"):
        t = find_task(con, a.task)
        delete_task(con, t["id"], a.cmd == "delete")
        print(f"#{t['id']} {a.cmd}d: {t['title']}")
    elif a.cmd == "log":
        args = a.args
        task = None
        if not re.fullmatch(r"[\d.]+[hm].*", args[0]):
            task, args = args[0], args[1:]
        if not args:
            raise SystemExit("git-timelog: missing duration (e.g. 45m, 1h30m)")
        t = find_task(con, task) if task else current_task(con)
        if not t:
            raise SystemExit("git-timelog: not on a feature branch; name a task")
        log_time(con, t["id"], parse_duration(args[0]), " ".join(args[1:]))
        print(f"logged {args[0]} on {t['title']}")
    elif a.cmd == "report":
        print(report(con, dt.date.fromisoformat(a.date) if a.date else None))


if __name__ == "__main__":
    sys.exit(main())
